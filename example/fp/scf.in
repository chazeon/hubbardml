&control
    calculation     = 'scf'
    restart_mode    = 'from_scratch'
    pseudo_dir      = './pseudo'
    tstress         = .true.
    tprnfor         = .true.
    etot_conv_thr   = 1.0D-2
    forc_conv_thr   = 1.0D-3
    nstep           = 600
/

&system
    ibrav           = 0
    nat             = 16
    ntyp            = 6
    ecutwfc         = 120.0
    ecutrho         = 480.0
    occupations     = 'smearing'
    smearing        = 'f-d'
    degauss         = 0.005
    nspin           = 2
    starting_magnetization(1) = 0.5
    starting_magnetization(2) = 0.5
    starting_magnetization(3) = 0.5
    starting_magnetization(4) = 0.5
/

&electrons
    conv_thr = 1.0D-4
    electron_maxstep = 100
    mixing_beta = 0.3D0
    scf_must_converge = .false.
    startingwfc = "atomic"
    startingpot = "atomic"
/

&ions
    ion_dynamics    = 'bfgs'
/

&cell
    cell_dofree     = 'shape'
    cell_dynamics   = 'bfgs'
/

